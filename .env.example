# Generate separate authentication secrets; keep these in the gitignored .env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CREDORA_API_KEY=
CREDORA_JWT_SECRET=

# Required for protected model/package storage: URL-safe base64 encoding of 32 bytes.
# AES-256-GCM is used, not Fernet; Fernet.generate_key() supplies a compatible key.
# Generate once, retain outside the repository in protected secret storage, and back up.
# Supply the existing deployment key at runtime. Never overwrite it to rotate keys.
# A colocated local .env does not protect against an attacker who can read it too.
# Production keys must be supplied separately from the artifact/repository files.
CREDORA_MODEL_ENCRYPTION_KEY=

# Per-actor distinct owner/model-path identities admitted within a sliding window.
CREDORA_MODEL_ACCESS_DISTINCT_LIMIT=20
CREDORA_MODEL_ACCESS_WINDOW_SECONDS=60
